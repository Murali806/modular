  "commands": [
    {
      "title": "Compare the frontend-shaped LLVM IR",
      "command": "clang --target=hexagon-unknown-unknown-elf -O0 -S -emit-llvm cross_compile_lesson.c -o ../evidence/cross_compile/cross_compile_lesson_O0.ll",
      "note": "A separate reference build. It keeps the source loop in an inspectable LLVM IR form."
    },
    {
      "title": "Capture optimized target LLVM IR",
      "command": "clang --target=hexagon-unknown-unknown-elf -O1 -fno-inline -S -emit-llvm cross_compile_lesson.c -o ../evidence/cross_compile/cross_compile_lesson_O1.ll",
      "note": "This separate invocation saves an inspectable LLVM IR snapshot."
    },
    {
      "title": "Emit Hexagon assembly text",
      "command": "clang --target=hexagon-unknown-unknown-elf -O1 -fno-inline -S cross_compile_lesson.c -o ../evidence/cross_compile/cross_compile_lesson_hexagon.s",
      "note": "This sibling output shows the backend result. The saved .s file is not input to the -c command."
    },
    {
      "title": "Emit a relocatable object",
      "command": "clang --target=hexagon-unknown-unknown-elf -O1 -fno-inline -c cross_compile_lesson.c -o ../evidence/cross_compile/cross_compile_lesson_hexagon.o",
      "note": "The compiler can write the object directly. Saving a .s file first is optional."
    },
    {
      "title": "Link the saved target object",
      "command": "clang --target=hexagon-unknown-unknown-elf ../evidence/cross_compile/cross_compile_lesson_hexagon.o -o ../evidence/cross_compile/cross_compile_lesson_hexagon.elf",
      "note": "The linker consumes OBJ1 and combines it with target startup objects and runtime libraries."
    },
    {
      "title": "Print the driver's link plan",
      "command": "clang --target=hexagon-unknown-unknown-elf -### ../evidence/cross_compile/cross_compile_lesson_hexagon.o -o ../evidence/cross_compile/cross_compile_lesson_hexagon.elf",
      "note": "Shows hexagon-link and target startup/runtime inputs without running the linker."
    },
    {
      "title": "Inspect the object and its unresolved call",
      "command": "llvm-readobj --file-headers --relocations ../evidence/cross_compile/cross_compile_lesson_hexagon.o",
      "note": "Observed relocation: R_HEX_B22_PCREL sum_to. The link step resolves it."
    },
    {
      "title": "Disassemble the object for inspection",
      "command": "hexagon-llvm-objdump -d ../evidence/cross_compile/cross_compile_lesson_hexagon.o",
      "note": "This reads existing object bytes; disassembly is an inspection view, not another compilation stage."
    }
  ],
